{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "nexjyoti-f92e5",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/verify/**",
        "destination": "/verify.html"
      },
      {
        "source": "/careers/joining/**",
        "destination": "/careers/joining.html"
      },
      {
        "source": "/careers/offer/**",
        "destination": "/careers/offer.html"
      },
      {
        "source": "/careers/**",
        "destination": "/careers.html"
      },
      {
        "source": "/admin",
        "destination": "/spa.html"
      },
      {
        "source": "/admin/**",
        "destination": "/spa.html"
      }
    ],
    "cleanUrls": true,
    "trailingSlash": false
  }
}
